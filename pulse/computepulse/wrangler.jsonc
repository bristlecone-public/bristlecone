{
	"name": "computepulse",
	"main": "src/index.js",
	"compatibility_date": "2026-08-01",
	"workers_dev": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"kv_namespaces": [
		// Create with: npx wrangler kv namespace create SNAPSHOTS
		// then paste the id here (and a preview_id for `wrangler dev`).
		{ "binding": "SNAPSHOTS", "id": "<your-kv-namespace-id>", "preview_id": "<your-preview-kv-namespace-id>" }
	],
	"triggers": {
		// One cron; per-instrument cadence gating lives in the collector.
		"crons": [] // triggered by gridpulse PEERS fan-out (Workers Free cron limit); restore "*/15 * * * *" on Paid
	},
	"observability": { "enabled": true },
	"routes": [{ "pattern": "computepulse.bristleconeanalytics.com", "custom_domain": true }]
}
