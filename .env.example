# Bristlecone — API keys for continuing work.
#
# This file is a COMMITTED TEMPLATE with placeholders only. Do not put real
# keys here. Instead copy it to `.env` (which is gitignored) and fill that in:
#
#     cp .env.example .env    # then edit .env in your editor
#
# Agent tool calls load `.env` at runtime (`set -a; . .env; set +a`) and read
# these by name, so the actual values are never printed into the chat.

# Census decennial API (api.census.gov). Free/instant key:
#   https://api.census.gov/data/key_signup.html
# Unblocks the finished 1990->2020 cohort-tracing run.
CENSUS_API_KEY=

# IPUMS / NHGIS API (ipums.org). Enables the 1950-1980 back-extension
# (net-new work; no code consumes this yet).
IPUMS_API_KEY=
